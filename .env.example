SPORTHUB_DB_URL=jdbc:postgresql://localhost:5432/sporthub
SPORTHUB_DB_USERNAME=postgres
SPORTHUB_DB_PASSWORD=replace-with-local-password
SPORTHUB_JWT_SECRET=replace-with-at-least-32-random-bytes
SPORTHUB_JWT_ISSUER=sporthub
SPORTHUB_JWT_ACCESS_TOKEN_TTL_SECONDS=900
SPORTHUB_CORS_ALLOWED_ORIGIN=http://localhost:5173
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
# true chỉ trên máy dev: trang giả lập tạo coin miễn phí
SPORTHUB_PAYMENT_FAKE_ENABLED=false
SPORTHUB_PAYMENT_FAKE_SECRET=replace-with-dev-secret
SPORTHUB_PAYMENT_FAKE_BASE_URL=http://localhost:8080
